  "deploy_lease_schema": {
    "required_before_node": "S30",
    "held_through_node": "S33",
    "required_fields": ["repository", "environment_scope", "integration_owner", "coordinator_or_lock", "acquired_at", "expires_at", "live_sha_at_acquire", "candidate_sha", "included_commits", "ready_artifacts", "ready_artifact_manifest_hash", "candidate_closure_hash", "deferred_ready_commits", "broadcast_receipt", "status"],
    "additional_fields": false,
    "environment_scope": ["staging", "production"],
    "active_status": "active",
    "terminal_statuses": ["released_after_live", "released_after_rollback"],
    "reject_when": [
      "missing, extra, empty, wrong-type, duplicate, unknown, or malformed field",
      "multiple integration owners or active leases for the repository and environment scope",
      "coordinator or project lock ownership cannot be proved",
      "expires_at is not after acquired_at or lease is expired",
      "live_sha_at_acquire differs from the immediately reread live SHA",
      "candidate_sha is absent from included_commits or changes after staging",
      "a ready accepted wave commit is neither included nor explicitly deferred with a wave-ledger stop reason",
      "included commit is not present in the clean integration candidate",
      "ready artifact record is missing artifact_id, source base/head, prerequisite closure, closure mode, or required hashes",
      "file_set closure path-set or content-tree hash does not recompute against the candidate",
      "full_diff closure hash does not recompute from source base through every prerequisite to source head",
      "ready artifact prerequisite content is absent even though a child or top commit is present",
      "ready artifact manifest or aggregate candidate closure hash differs after conflict resolution",
      "ready artifacts overlap paths without an approved aggregate resolution record",
      "non-owner staging or production caller differs from integration_owner",
      "lease terminates without exact-live or rollback receipt"
    ]
  },
  "exact_state_incident_schema": {
    "required_fields": ["control_id", "release_sha", "state_class_hash", "environment", "reproduction_steps_hash", "expected", "observed", "severity_trigger", "evidence_hash", "independent_confirmation", "disposition", "repair_scope", "rollback_pointer", "owner", "stop_condition"],
    "additional_fields": false,
    "control_ids": ["FB-P06", "FB-P08"],
    "severity_triggers": ["state_loss", "blocked_core_action", "duplicate_write", "sustained_5xx", "truth_breach", "accessibility_blocker", "none"],
    "dispositions": ["reproduced", "not_reproduced", "monitor", "repair_now", "contain_now"],
    "product_change_dispositions": ["repair_now"],
    "reject_when": [
      "missing, extra, empty, wrong-type, unknown, or malformed field",
      "release SHA or evidence hashes do not match their declared patterns",
      "record contains a raw save, player, worker, relationship, session, or feedback identifier",
      "repair_now has severity_trigger none or lacks independent confirmation, bounded repair scope, rollback pointer, owner, or deterministic stop condition",
      "contain_now is not an actively observed production emergency or expands beyond reversible containment",
      "reproduced, not_reproduced, monitor, or contain_now is used to authorize product feature work"
    ]
  },
  "evidence_gate_schema": {
    "required_fields": ["row_id", "evidence_kind", "required_threshold", "observed_threshold", "eligible_denominator", "protocol_hash", "privacy_guard", "status", "allowed_actions", "product_change_authorized", "owner", "next_evaluation"],
    "additional_fields": false,
    "evidence_kinds": ["unprompted_human", "privacy_safe_volume"],
    "statuses": ["evidence_blocked", "threshold_met"],
    "allowed_actions": ["measure", "recruit", "run_protocol", "reproduce"],
    "product_change_authorized": false,
    "reject_when": [
      "missing, extra, empty, wrong-type, unknown, or malformed field",
      "observed threshold is below required threshold but status is threshold_met",
      "privacy_safe_volume lacks an eligible denominator or small-cell suppression",
      "unprompted_human lacks a protocol hash",
      "allowed actions contain product implementation, UI, copy, simulation, economy, progression, or system changes",
      "product_change_authorized is true",
      "next_evaluation is a speculative date rather than an explicit evidence condition"
    ]
  },
  "applicability_schema": {
    "predicate_ids": ["always", "cpu_system_scope_present", "backend_change_required", "frontend_change_required"],
    "skip_reasons": ["predicate_false"],
    "record_required_fields": ["node_id", "predicate_id", "result", "evidence_hash", "evaluated_spec_hash", "owner", "consumer_impact", "status", "skip_reason"],
    "record_additional_fields": false,
    "statuses": ["ready", "complete", "not_applicable"],
    "hash_pattern": "^sha256:[0-9a-f]{64}$",
    "conditional_functions": {
      "cpu_system_scope_present": {
        "source_node": "S09",
        "source_schema": "cpu-system-registry",
        "true_when": "complete == true AND EXISTS systems[*] WHERE delegated_or_automatic == true AND change_scope IN allowed_change_scopes",
        "false_when": "complete == true AND NOT EXISTS matching systems[*]",
        "allowed_change_scopes": ["introduced", "materially_changed", "authority_changed", "shared_conflict_changed", "promise_or_policy_changed"],
        "invalid_when": ["complete != true", "unknown change_scope", "duplicate system_id", "malformed system"]
      },
      "backend_change_required": {
        "source_node": "S16",
        "source_schema": "architecture-flow-map",
        "true_when": "complete == true AND backend IN implementation_surfaces",
        "false_when": "complete == true AND backend NOT IN implementation_surfaces",
        "allowed_surfaces": ["backend", "frontend"],
        "invalid_when": ["complete != true", "unknown surface", "duplicate surface", "malformed array", "no backend or frontend surface"]
      },
      "frontend_change_required": {
        "source_node": "S16",
        "source_schema": "architecture-flow-map",
        "true_when": "complete == true AND frontend IN implementation_surfaces",
        "false_when": "complete == true AND frontend NOT IN implementation_surfaces",
        "allowed_surfaces": ["backend", "frontend"],
        "invalid_when": ["complete != true", "unknown surface", "duplicate surface", "malformed array", "no backend or frontend surface"]
      }
    },
    "reject_when": [
      "missing, extra, wrong-type, empty, duplicate, unknown, or malformed field",
      "hash shape or content mismatch",
      "evidence_hash differs from canonical S09 or S16 artifact hash",
      "owner differs from declared node owner",
      "consumer_impact is empty, unknown, or incorrect",
      "result is not Boolean",
      "always predicate result is false",
      "status is not_applicable while result is true",
      "conditional result is false while status is not not_applicable",
      "skip_reason is non-null on a true or executed node",
      "skipped node has missing or alternate skip_reason",
      "evaluated_spec_hash differs from envelope spec hash",
      "incomplete or malformed source artifact is treated as false",
      "CPU program has false cpu_system_scope_present",
      "backend_change_required and frontend_change_required are both false"
    ]
  },
